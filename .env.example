# Weekly Report App - Environment Variables Template
# Copy this file to .env and fill in the values

# ===================
# Database (PostgreSQL)
# ===================
# Development (Docker Compose): Use default values
# Production (Neon): Use connection string from Neon dashboard
DATABASE_URL=postgresql://app_user:app_password@db:5432/weekly_report

# PostgreSQL container settings (development only)
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=weekly_report

# ===================
# NextAuth.js
# ===================
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ===================
# API (Frontend -> Backend)
# ===================
# Development: http://backend:8000 (Docker internal)
# Production: https://your-fly-app.fly.dev
API_URL=http://backend:8000
